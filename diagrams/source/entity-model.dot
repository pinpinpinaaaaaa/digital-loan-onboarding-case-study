digraph E { graph [rankdir=LR, fontname="Arial", nodesep=0.6, ranksep=1.1, pad=0.3, label="Data Entity Model (logical)\n", labelloc=t, fontsize=16];
node [fontname="Arial", fontsize=10, shape=plain]; edge [fontname="Arial", fontsize=10, dir=both, color="#404040"];
Customer [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#1F3A68"><tr><td colspan="2" bgcolor="#1F3A68"><font color="white"><b>Customer</b></font></td></tr><tr><td align="left"><font color="#C00000"><b>PK</b></font></td><td align="left">customer_id</td></tr><tr><td align="left"><font color="#2E75B6"><b>&#160;</b></font></td><td align="left">full_name</td></tr><tr><td align="left"><font color="#2E75B6"><b>&#160;</b></font></td><td align="left">date_of_birth</td></tr><tr><td align="left"><font color="#2E75B6"><b>&#160;</b></font></td><td align="left">email / phone</td></tr><tr><td align="left"><font color="#2E75B6"><b>&#160;</b></font></td><td align="left">residential_address</td></tr><tr><td align="left"><font color="#2E75B6"><b>&#160;</b></font></td><td align="left">ssn_token (masked)</td></tr><tr><td align="left"><font color="#2E75B6"><b>&#160;</b></font></td><td align="left">created_at</td></tr></table>>];
Application [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#1F3A68"><tr><td colspan="2" bgcolor="#1F3A68"><font color="white"><b>Application</b></font></td></tr><tr><td align="left"><font color="#C00000"><b>PK</b></font></td><td align="left">application_id</td></tr><tr><td align="left"><font color="#2E75B6"><b>FK</b></font></td><td align="left">customer_id</td></tr><tr><td align="left"><font color="#2E75B6"><b>&#160;</b></font></td><td align="left">loan_amount / term</td></tr><tr><td align="left"><font color="#2E75B6"><b>&#160;</b></font></td><td align="left">annual_income</td></tr><tr><td align="left"><font color="#2E75B6"><b>&#160;</b></font></td><td align="left">channel (web/mobile)</td></tr><tr><td align="left"><font color="#2E75B6"><b>&#160;</b></font></td><td align="left">status</td></tr><tr><td align="left"><font color="#2E75B6"><b>&#160;</b></font></td><td align="left">decision / reason_codes</td></tr><tr><td align="left"><font color="#2E75B6"><b>&#160;</b></font></td><td align="left">submitted_at / decided_at</td></tr></table>>];
Consent [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#1F3A68"><tr><td colspan="2" bgcolor="#1F3A68"><font color="white"><b>Consent</b></font></td></tr><tr><td align="left"><font color="#C00000"><b>PK</b></font></td><td align="left">consent_id</td></tr><tr><td align="left"><font color="#2E75B6"><b>FK</b></font></td><td align="left">application_id</td></tr><tr><td align="left"><font color="#2E75B6"><b>&#160;</b></font></td><td align="left">consent_type</td></tr><tr><td align="left"><font color="#2E75B6"><b>&#160;</b></font></td><td align="left">disclosure_version</td></tr><tr><td align="left"><font color="#2E75B6"><b>&#160;</b></font></td><td align="left">granted_at / ip_device</td></tr></table>>];
KYCCheck [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#1F3A68"><tr><td colspan="2" bgcolor="#1F3A68"><font color="white"><b>KYCCheck</b></font></td></tr><tr><td align="left"><font color="#C00000"><b>PK</b></font></td><td align="left">kyc_check_id</td></tr><tr><td align="left"><font color="#2E75B6"><b>FK</b></font></td><td align="left">application_id</td></tr><tr><td align="left"><font color="#2E75B6"><b>&#160;</b></font></td><td align="left">provider_ref</td></tr><tr><td align="left"><font color="#2E75B6"><b>&#160;</b></font></td><td align="left">result (pass/review/fail)</td></tr><tr><td align="left"><font color="#2E75B6"><b>&#160;</b></font></td><td align="left">match_score</td></tr><tr><td align="left"><font color="#2E75B6"><b>&#160;</b></font></td><td align="left">checked_at</td></tr></table>>];
CreditPull [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#1F3A68"><tr><td colspan="2" bgcolor="#1F3A68"><font color="white"><b>CreditPull</b></font></td></tr><tr><td align="left"><font color="#C00000"><b>PK</b></font></td><td align="left">credit_pull_id</td></tr><tr><td align="left"><font color="#2E75B6"><b>FK</b></font></td><td align="left">application_id</td></tr><tr><td align="left"><font color="#2E75B6"><b>&#160;</b></font></td><td align="left">pull_type (soft)</td></tr><tr><td align="left"><font color="#2E75B6"><b>&#160;</b></font></td><td align="left">bureau</td></tr><tr><td align="left"><font color="#2E75B6"><b>&#160;</b></font></td><td align="left">credit_score / DTI</td></tr><tr><td align="left"><font color="#2E75B6"><b>&#160;</b></font></td><td align="left">response_status / retries</td></tr><tr><td align="left"><font color="#2E75B6"><b>&#160;</b></font></td><td align="left">pulled_at</td></tr></table>>];
AuditLog [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#1F3A68"><tr><td colspan="2" bgcolor="#1F3A68"><font color="white"><b>AuditLog</b></font></td></tr><tr><td align="left"><font color="#C00000"><b>PK</b></font></td><td align="left">audit_id</td></tr><tr><td align="left"><font color="#2E75B6"><b>FK</b></font></td><td align="left">application_id</td></tr><tr><td align="left"><font color="#2E75B6"><b>&#160;</b></font></td><td align="left">actor (system/user)</td></tr><tr><td align="left"><font color="#2E75B6"><b>&#160;</b></font></td><td align="left">action</td></tr><tr><td align="left"><font color="#2E75B6"><b>&#160;</b></font></td><td align="left">before / after hash</td></tr><tr><td align="left"><font color="#2E75B6"><b>&#160;</b></font></td><td align="left">timestamp</td></tr></table>>];
Customer->Application [arrowtail=teetee, arrowhead=crowodot, label="submits 1:N"];
Application->Consent [arrowtail=teetee, arrowhead=crowtee, label="records 1:N"];
Application->KYCCheck [arrowtail=teetee, arrowhead=crowodot, label="triggers 1:N"];
Application->CreditPull [arrowtail=teetee, arrowhead=crowodot, label="requests 1:N"];
Application->AuditLog [arrowtail=teetee, arrowhead=crowtee, label="logged by 1:N"];
}